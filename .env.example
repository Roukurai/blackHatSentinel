# ---- identity ----
HOST_ID=ubuntu-01

# ---- API ----
API_BIND=0.0.0.0
API_PORT=8080
API_URL=http://127.0.0.1:8080          # used by the collector
PUBLIC_BASE_URL=http://<vps-ip>:8080   # used in Telegram links
DB_PATH=./data/sentinel.db
DASHBOARD_USER=
DASHBOARD_PASS=

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_COOLDOWN_SECONDS=300

# ---- LLM (OpenAI chat/completions + tools) ----
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=                          # from https://platform.openai.com/api-keys — never commit
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30

# ---- detection ----
DETECT_FAST_COUNT=5
DETECT_FAST_WINDOW_SECONDS=120
DETECT_SLOW_COUNT=10
DETECT_SLOW_WINDOW_SECONDS=1800
DETECT_SPRAY_DISTINCT_USERS=5

# ---- response (P1) ----
RESPONSE_ALLOWLIST=                    # comma-separated CIDRs: venue IPs, VPS IP, team IPs. NOT the attacker.
RESPONSE_BLOCK_TTL_SECONDS=600
RESPONSE_RUNNER=                       # /usr/local/sbin/sentinel-block (ops/sentinel-block); empty = approvals fail honestly
RESPONSE_RUNNER_SUDO=0                 # 1 = run the runner via `sudo -n` (sudoers entry in the script header)

# ---- dashboard ----
WEB_DIST=web/dist                      # built dashboard served by the API (npm run build --prefix web)

# ---- collector ----
COLLECTOR_MODE=live                    # live | replay
COLLECTOR_REPLAY_FILE=                 # path to journalctl -o json export (replay mode)
COLLECTOR_STATE_FILE=/var/lib/sentinel/cursor
COLLECTOR_BATCH_MAX=500
