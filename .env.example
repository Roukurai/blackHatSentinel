# ---- identity ----
HOST_ID=ubuntu-01

# ---- API ----
API_BIND=0.0.0.0
API_PORT=8080
API_URL=http://127.0.0.1:8080          # used by the collector
PUBLIC_BASE_URL=http://<vps-ip>:8080   # used in Telegram links
DB_PATH=./data/sentinel.db
# Leave both empty to choose this password in the browser on first launch.
# It is stored hashed next to the database. MCP must present the same pair
# (the authenticate tool, or SENTINELL_USER / SENTINELL_PASSWORD).
DASHBOARD_USER=
DASHBOARD_PASS=

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
# One chat, or several separated by commas. Each person who messages the bot is added too.
TELEGRAM_CHAT_ID=
NOTIFY_COOLDOWN_SECONDS=300

# ---- LLM (BYO — OpenAI-compatible chat/completions + tools) ----
# Boot defaults when dashboard Settings has no active key yet.
# Prefer dashboard Settings for multi-provider keys (OpenAI, Anthropic, Gemini,
# OpenRouter, Custom) — they hot-reload without restarting the API.
# Never commit real keys. Investigator uses /chat/completions on LLM_BASE_URL.
#
# Examples (pick one pair; leave others blank):
#   OpenAI:     LLM_BASE_URL=https://api.openai.com/v1
#               LLM_API_KEY=sk-…
#               LLM_MODEL=gpt-4o-mini
#   Anthropic:  LLM_BASE_URL=https://api.anthropic.com/v1   (or OpenRouter)
#               LLM_API_KEY=sk-ant-…
#               LLM_MODEL=claude-sonnet-4-5
#   Gemini:     LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#               LLM_API_KEY=AIza…
#               LLM_MODEL=gemini-2.0-flash
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1
#               LLM_API_KEY=sk-or-…
#               LLM_MODEL=openai/gpt-4o-mini
#   Custom:     LLM_BASE_URL=https://your-proxy.example/v1
#               LLM_API_KEY=
#               LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=                          # never commit — OpenAI sk-… / Anthropic sk-ant-… / Gemini AIza… / OpenRouter sk-or-…
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30

# ---- detection ----
DETECT_FAST_COUNT=5
DETECT_FAST_WINDOW_SECONDS=120
DETECT_SLOW_COUNT=10
DETECT_SLOW_WINDOW_SECONDS=1800
DETECT_SPRAY_DISTINCT_USERS=5

# ---- response (P1) ----
RESPONSE_ALLOWLIST=                    # CIDRs: VPS IP, team IPs. Venue has no fixed public IP — check before demo. NOT the attacker. Mirror into /etc/sentinel/allowlist on the VPS.
RESPONSE_BLOCK_TTL_SECONDS=600
RESPONSE_RUNNER=                       # /usr/local/sbin/sentinel-block (ops/sentinel-block); empty = approvals fail honestly
RESPONSE_RUNNER_SUDO=0                 # 1 = run the runner via `sudo -n` (sudoers entry in the script header)

# ---- dashboard ----
WEB_DIST=web/dist                      # built dashboard served by the API (npm run build --prefix web)

# ---- collector ----
COLLECTOR_MODE=live                    # live | replay
COLLECTOR_REPLAY_FILE=                 # path to journalctl -o json export (replay mode)
COLLECTOR_STATE_FILE=/var/lib/sentinel/cursor
COLLECTOR_BATCH_MAX=500
