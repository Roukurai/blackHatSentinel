#!/usr/bin/env bash
# Thin CLI shim so landing-page MCP prompts work: `sentinell mcp`
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
CMD="${1:-}"

usage() {
  cat <<'EOF'
sentinell — SSH attack triage helpers

Usage:
  sentinell mcp                         Start read-only MCP server (stdio)
  sentinell mcp token create --name N   Generate remote MCP Bearer token (printed once)
  sentinell mcp token list              List token metadata (no secrets)
  sentinell mcp token revoke <id>       Revoke a token
  sentinell status                      Print API /health if reachable
  sentinell help

Remote MCP (after create): POST https://<host>/mcp with Authorization: Bearer <token>
See docs/MCP.md. Prefer TLS in front of the API.

Install PATH tip (after ops/install.sh):
  export PATH="$HOME/.local/bin:$PATH"
EOF
}

case "$CMD" in
  mcp)
    shift || true
    SUB="${1:-}"
    if [[ "$SUB" == "token" ]]; then
      shift || true
      exec node --experimental-strip-types "$ROOT/api/src/mcp/token-cli.ts" "$@"
    fi
    exec node --experimental-strip-types "$ROOT/api/src/mcp/server.ts" "$@"
    ;;
  status)
    API_URL="${API_URL:-http://127.0.0.1:8080}"
    curl -fsS "$API_URL/health" | head -c 2000
    echo
    ;;
  help|-h|--help|"")
    usage
    ;;
  *)
    echo "unknown command: $CMD" >&2
    usage >&2
    exit 1
    ;;
esac
