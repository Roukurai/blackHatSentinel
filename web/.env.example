# Dev-only settings for `npm run dev`. Never put credentials here.

# Where the Vite dev proxy forwards API calls (Kevin's API).
VITE_API_TARGET=http://127.0.0.1:8080

# Path prefix of the JSON API. Empty = API at the root (/health, /incidents), which is
# what api/ serves today. The dev proxy sends text/html navigations to the SPA instead.
VITE_API_BASE=

# 1 = use local fixture data (clearly bannered, dev builds only).
VITE_FIXTURES=0
