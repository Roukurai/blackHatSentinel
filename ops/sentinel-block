#!/usr/bin/env bash
# Sentinel response runner: the only privileged code path for P1 IP blocks.
# Fixed command set, strict argument validation, no shell interpolation of input.
#
#   sentinel-block block <ip> <ttl_seconds>   add a temporary element to the blocklist
#   sentinel-block verify <ip>                exit 0 if <ip> is currently blocked
#   sentinel-block unblock <ip>               remove <ip> early (rollback)
#
# Install (root):
#   install -m 0755 -o root -g root ops/sentinel-block /usr/local/sbin/sentinel-block
#   echo 'sentinel ALL=(root) NOPASSWD: /usr/local/sbin/sentinel-block' > /etc/sudoers.d/sentinel-block
#   chmod 0440 /etc/sudoers.d/sentinel-block
# API .env: RESPONSE_RUNNER=/usr/local/sbin/sentinel-block  RESPONSE_RUNNER_SUDO=1
#
# Policy (allowlist, own IPs) is enforced by the API before calling this script.
set -euo pipefail

MAX_TTL=86400

die() { echo "sentinel-block: $*" >&2; exit 2; }

[[ $# -ge 2 ]] || die "usage: sentinel-block block|verify|unblock <ip> [ttl_seconds]"
cmd=$1
ip=$2

if [[ $ip =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]]; then
  for octet in "${BASH_REMATCH[@]:1}"; do (( octet <= 255 )) || die "invalid IPv4"; done
  set_name=blocklist
elif [[ $ip =~ ^[0-9A-Fa-f:]+$ && $ip == *:* && ${#ip} -le 39 ]]; then
  set_name=blocklist6
else
  die "invalid IP"
fi

ensure_table() {
  nft list table inet sentinel >/dev/null 2>&1 && return 0
  nft -f - <<'EOF'
table inet sentinel {
  set blocklist  { type ipv4_addr; flags timeout; }
  set blocklist6 { type ipv6_addr; flags timeout; }
  chain input {
    type filter hook input priority -10; policy accept;
    ip saddr @blocklist drop
    ip6 saddr @blocklist6 drop
  }
}
EOF
}

case $cmd in
  block)
    [[ $# -eq 3 && $3 =~ ^[0-9]+$ ]] || die "ttl_seconds must be a positive integer"
    (( $3 >= 1 && $3 <= MAX_TTL )) || die "ttl_seconds out of range (1..$MAX_TTL)"
    ensure_table
    nft add element inet sentinel "$set_name" "{ $ip timeout ${3}s }"
    ;;
  verify)
    nft list set inet sentinel "$set_name" 2>/dev/null | grep -qw -- "$ip"
    ;;
  unblock)
    nft delete element inet sentinel "$set_name" "{ $ip }"
    ;;
  *)
    die "unknown command: $cmd"
    ;;
esac
